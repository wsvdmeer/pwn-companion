# Release signing config for PwnCompanion.
#
# 1. Generate a keystore (you choose the password, entered interactively):
#      keytool -genkeypair -v -keystore release.jks -alias pwncompanion \
#              -keyalg RSA -keysize 2048 -validity 10000
# 2. Copy this file to `keystore.properties` and fill in your values (same password
#    you set above for both store and key if you accepted the default).
# 3. Build:  ./gradlew assembleRelease
#
# keystore.properties and *.jks are git-ignored — NEVER commit them, and BACK UP the
# .jks: losing it means you can't sign updates to an already-installed app.

storeFile=release.jks
storePassword=CHANGEME
keyAlias=pwncompanion
keyPassword=CHANGEME
