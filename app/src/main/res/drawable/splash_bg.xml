<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start / window background: the terminal face on near-black. Prevents a white
     flash before Compose draws, and is the splash on pre-Android-12 devices. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/crt_black" />
    <item
        android:width="140dp"
        android:height="140dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
