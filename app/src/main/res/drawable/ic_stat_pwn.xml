<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar / notification small icon: a Wi-Fi signal (concentric arcs + dot) as a white
     silhouette on transparent — Android tints it. Simple + bold so it reads at ~24dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- outer arc -->
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8" android:strokeLineCap="round"
        android:pathData="M4.2,10.4 Q12,4.9 19.8,10.4" />
    <!-- middle arc -->
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8" android:strokeLineCap="round"
        android:pathData="M6.9,12.9 Q12,8.7 17.1,12.9" />
    <!-- inner arc -->
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8" android:strokeLineCap="round"
        android:pathData="M9.4,15.4 Q12,12.7 14.6,15.4" />
    <!-- dot -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M10.6,17.7 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 z" />
</vector>
